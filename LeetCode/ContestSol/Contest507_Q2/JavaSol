//Valid Subarrays With Matching Sum Digits I
class Solution {
    public int countValidSubarrays(int[] nums, int x) {
        int count = 0;
        //System.out.println(windowSum);
        for(int i=0; i<nums.length; i++){
            long sum = 0;
            for(int j=i; j<nums.length; j++){
                sum+=nums[j];
                
                long last = sum % 10;
                long first = sum;
                while(first >=10){
                    first = first/10;
                }
                if((int)first==x && (int)last == x){
                    count++;
                }
            }
        }
        return count;
    }
}